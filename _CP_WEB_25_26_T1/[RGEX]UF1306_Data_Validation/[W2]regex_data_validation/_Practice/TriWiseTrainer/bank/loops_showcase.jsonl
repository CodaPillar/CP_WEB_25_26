{"id":"LP-01","type":"tri","tier":1,"category":"Loops","question":"Which loop is best when you know the exact number of iterations?","options":["while","for","do...while","for...in"],"answer":"for","hint":"Classic counter loop.","explain":"`for (let i=0;i<n;i++)`."}
{"id":"LP-02","type":"tri","tier":1,"category":"Loops","question":"Which loop guarantees the body runs at least once?","options":["while","for","do...while","for...of"],"answer":"do...while","hint":"Condition checked after the body.","explain":"`do { ... } while (cond)`."}
{"id":"LP-03","type":"tri","tier":1,"category":"Loops","question":"Which loop iterates values of an iterable (like arrays)?","options":["for...in","for...of","foreach","loop...of"],"answer":"for...of","hint":"Think: values, not keys.","explain":"`for (const v of arr) {}`."}
{"id":"LP-04","type":"tri","tier":1,"category":"Loops","question":"Which loop iterates object keys?","options":["for...of","for...in","foreach","keys...of"],"answer":"for...in","hint":"In → indexes/keys.","explain":"`for (const k in obj) {}`."}
{"id":"LP-05","type":"tri","tier":1,"category":"Loops","question":"What does `break` do inside a loop?","options":["skips this iteration","exits the loop","restarts the loop","does nothing"],"answer":"exits the loop","hint":"It stops completely.","explain":"`break` terminates the loop."}
{"id":"LP-06","type":"tri","tier":1,"category":"Loops","question":"What does `continue` do inside a loop?","options":["exits the loop","skips the rest of this iteration","restarts the loop","pauses the loop"],"answer":"skips the rest of this iteration","hint":"It jumps to the next turn.","explain":"`continue` goes to the next iteration."}
{"id":"LP-07","type":"short","tier":1,"category":"Loops","question":"Write a `for` loop that logs numbers 0..2.","answer":"for (let i=0;i<=2;i++){ console.log(i); }","hint":"Start at 0, stop at 2.","explain":"Three iterations: 0,1,2."}
{"id":"LP-08","type":"short","tier":2,"category":"Loops","question":"Write a `while` loop that halves `n` until `n < 1`.","answer":"while(n>=1){ n=n/2; }","hint":"Check condition before body.","explain":"Stop when the value is below 1."}
{"id":"LP-09","type":"short","tier":2,"category":"Loops","question":"Use `for...of` to print each name in `names`.","answer":"for (const name of names){ console.log(name); }","hint":"Iterate values.","explain":"`for...of` gives each element."}
{"id":"LP-10","type":"tri","tier":2,"category":"Loops","question":"Which is safer for arrays when order matters and you need indexes?","options":["for...in","for...of","Object.keys","while"],"answer":"for...of","hint":"`for...in` order on arrays isn’t guaranteed.","explain":"Prefer `for...of` or classic `for` for arrays."}
{"id":"LP-11","type":"tri","tier":2,"category":"Loops","question":"Best way to build a new array from another array?","options":["forEach","map","reduce","for...in"],"answer":"map","hint":"Transformation returns new array.","explain":"`map` is declarative and non-mutating."}
{"id":"LP-12","type":"short","tier":3,"category":"Loops","question":"Create `evens` from `nums` keeping only even numbers.","answer":"const evens = nums.filter(x=>x%2===0)","hint":"Use filter with a modulus test.","explain":"Keeps numbers divisible by 2."}
{"id":"LP-13","type":"short","tier":3,"category":"Loops","question":"Accumulate the product of all numbers in `nums`.","answer":"nums.reduce((acc,x)=>acc*x,1)","hint":"Reduce, start at 1.","explain":"Multiply into the accumulator."}
