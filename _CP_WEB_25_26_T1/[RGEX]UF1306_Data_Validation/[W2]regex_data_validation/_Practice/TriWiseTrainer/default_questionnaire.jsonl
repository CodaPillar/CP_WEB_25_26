{"id":"T-CLASSIC-1","type":"tri","tier":1,"lang":"en","category":"Operators","subcat":"classification","question":"Classify the expression: `age >= 18 && hasID`","code":"/* no runtime needed */","options":["correct","variable","incorrect"],"answer":"variable","hint":"It depends on runtime variables.","explain":"Syntactically valid; value depends on `age` and `hasID` → variable."}
{"id":"T-CUSTOM-1","type":"tri","tier":1,"lang":"en","category":"Types & typeof","subcat":"typeof-basic","question":"What does `typeof (2.5).toFixed(0)` return?","code":"typeof (2.5).toFixed(0);","options":["\"string\"","\"number\"","\"undefined\""],"answer":"\"string\"","hint":"toFixed returns formatted text.","explain":"`toFixed()` returns a string; `typeof` → \"string\"."}
{"id":"T-CUSTOM-2","type":"tri","tier":2,"lang":"en","category":"Types & typeof","subcat":"function-vs-output","question":"`typeof f` vs `typeof f()` which inspects the return type?","code":"function f(){return 42;} /* choose */","options":["typeof f()","typeof f","typeof (f && f)"],"answer":"typeof f()","hint":"Call it to see the result type.","explain":"`typeof f()` is \"number\"; `typeof f` is \"function\"."}
{"id":"S-PLAIN-1","type":"short","tier":1,"lang":"en","category":"Basics","subcat":"console-output","question":"What does this print?","code":"console.log(3 + 4 * 2);","answer":"11","hint":"Order of operations.","explain":"Multiplication first: 3 + (4*2) = 11."}
{"id":"S-WITH-SETUP-1","type":"short","tier":2,"lang":"en","category":"Scoping","subcat":"setup-vars","question":"What does this print?","setup":"const a = 5, b = '5';","code":"console.log(a == b, a === b);","answer":"true false","hint":"Loose vs strict equality.","explain":"`==` coerces → true; `===` compares type → false."}
{"id":"C-EXPR-1","type":"code","tier":1,"lang":"en","category":"Expressions","subcat":"expr-basic","prompt":"Write a single expression that evaluates to 49.","scaffold":"7*7","validator":{"mode":"expr","tests":["result === 49"]},"hint":"Only one expression; no declarations.","explain":"In expr mode, we evaluate your expression and tests read `result`."}
{"id":"C-EXPR-ENV-1","type":"code","tier":2,"lang":"en","category":"Expressions","subcat":"expr-env","prompt":"Use the provided variables to compute a^b as a single expression.","scaffold":"a ** b","validator":{"mode":"expr","runtime":{"vars":{"a":2,"b":3}},"tests":["result === 8"]},"hint":"`a` and `b` are available in env.","explain":"Your expression runs with `env`; tests assert on `result`."}
{"id":"C-FN-1","type":"code","tier":2,"lang":"en","category":"Functions","subcat":"fn-basic","prompt":"Return a function that doubles a number.","scaffold":"(x)=>x*2","validator":{"mode":"fn","tests":["typeof fn==='function'","fn.length===1","fn(5)===10","fn(-3)===-6"]},"hint":"Return the function value, don’t call it.","explain":"In fn mode, your submission must evaluate to a function; tests call `fn(...)`."}
{"id":"C-FN-2","type":"code","tier":3,"lang":"en","category":"Functions","subcat":"fn-closure","prompt":"Return a function that adds `k` (from env) to its argument.","scaffold":"(x)=>x+k","validator":{"mode":"fn","runtime":{"vars":{"k":7}},"tests":["typeof fn==='function'","fn(3)===10"]},"hint":"`k` is injected via env.","explain":"Closures over env are fine; tests check `fn(3)===10`."}
{"id":"C-PROG-1","type":"code","tier":2,"lang":"en","category":"Programs","subcat":"prog-exports","prompt":"Define `makeLabel(label,n)` → `${label} = ${Number(n)}` and expose it as `exports.makeLabel`.","scaffold":"function makeLabel(label=\"Value\", n=0){\n  return `${label} = ${Number(n)}`;\n}\nexports.makeLabel = makeLabel;","validator":{"mode":"prog","tests":["typeof exports.makeLabel==='function'","exports.makeLabel('Emails',3)==='Emails = 3'"]},"hint":"Attach public API to `exports`.","explain":"In prog mode, anything set on `exports.*` is visible to tests."}
{"id":"T-CLASSIC-2","type":"tri","tier":1,"lang":"en","category":"Logic","subcat":"truthy-falsy","question":"Classify: `!![]`","code":"","options":["correct","variable","incorrect"],"answer":"correct","hint":"Arrays are truthy.","explain":"`[]` is truthy; `!![]` is always `true` → correct."}
{"id":"S-PLAIN-2","type":"short","tier":1,"lang":"en","category":"Strings","subcat":"concat","question":"What does this print?","code":"console.log('Hi' + ' ' + 'there');","answer":"Hi there","hint":"Simple concatenation.","explain":"String + string concatenates literally."}
