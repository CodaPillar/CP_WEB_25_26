{"id": "AR2-1", "type": "short", "tier": 2, "lang": "en", "category": "Operators", "subcat": "unary/increment", "setup": "let x=5;", "question": "What does console.log print?", "code": "console.log(x++);", "answer": "5", "hint": "Postfix returns the old value, then increments.", "explain": "`x++` prints 5; afterwards `x` becomes 6."}
{"id": "AR2-2", "type": "short", "tier": 2, "lang": "en", "category": "Operators", "subcat": "unary/increment", "setup": "let x=5;", "question": "What does console.log print?", "code": "console.log(++x);", "answer": "6", "hint": "Prefix increments, then returns the new value.", "explain": "`++x` increments to 6, then prints 6."}
{"id": "AR2-3", "type": "short", "tier": 2, "lang": "en", "category": "Operators", "subcat": "unary/increment", "setup": "let x=1, y=2;", "question": "What does console.log print?", "code": "console.log(x + y++);", "answer": "3", "hint": "`y++` uses 2 in the expression, then becomes 3.", "explain": "Sum uses `y=2`, so `1 + 2` → 3."}
{"id": "AR2-4", "type": "short", "tier": 2, "lang": "en", "category": "Operators", "subcat": "unary/increment", "setup": "let x=1, y=2;", "question": "What does console.log print?", "code": "console.log(x + ++y);", "answer": "4", "hint": "`++y` increments before participating in the sum.", "explain": "`y` becomes 3, then `1 + 3` → 4."}
{"id": "AR2-5", "type": "short", "tier": 2, "lang": "en", "category": "Operators", "subcat": "unary/coercion", "question": "What does console.log print?", "code": "console.log(+true + +\"2\");", "answer": "3", "hint": "Unary plus converts to number.", "explain": "`+true` → 1, `+\"2\"` → 2, sum → 3."}
{"id": "AR2-6", "type": "short", "tier": 2, "lang": "en", "category": "Operators", "subcat": "unary/coercion", "question": "What does console.log print?", "code": "console.log(-\"3\" + 1);", "answer": "-2", "hint": "Unary minus also converts to number.", "explain": "`-\"3\"` → `-3`; add 1 → `-2`."}
{"id": "AR2-7", "type": "short", "tier": 2, "lang": "en", "category": "Operators", "subcat": "unary/coercion", "question": "What does console.log print?", "code": "console.log(+\"\");", "answer": "0", "hint": "Empty string converts to 0 with unary plus.", "explain": "`+\"\"` is `0`."}
{"id": "AR2-8", "type": "short", "tier": 2, "lang": "en", "category": "Operators", "subcat": "unary/coercion", "question": "What does console.log print?", "code": "console.log(+\"  \\n\\t  \");", "answer": "0", "hint": "Whitespace-only strings convert to 0.", "explain": "Trimming then numeric conversion yields `0`."}
