{"id": "OP2-1", "type": "short", "tier": 2, "lang": "en", "category": "Operators & Expressions", "subcat": "postfix-increment", "setup": "var nombre="Jab";\nlet edad=18;\nconst OJOS=2;", "question": "What does the alert show?", "code": "alert(edad++ - OJOS);", "answer": "16", "hint": "x++ uses the current value, then increments.", "explain": "edad++ yields 18, then edad becomes 19. 18 - 2 = 16."}
{"id": "OP2-2", "type": "short", "tier": 2, "lang": "en", "category": "Operators & Expressions", "subcat": "prefix-decrement", "setup": "var nombre="Jab";\nlet edad=18;\nconst OJOS=2;", "question": "What does the alert show?", "code": "alert(OJOS + --edad);", "answer": "19", "hint": "--x decrements first, then uses the new value.", "explain": "--edad makes edad 17, then 2 + 17 = 19."}
{"id": "OP2-3", "type": "short", "tier": 2, "lang": "en", "category": "Operators & Expressions", "subcat": "unary-plus-assignment", "setup": "var nombre="Jab";\nlet edad=18;\nconst OJOS=2;", "question": "What does the alert show?", "code": "alert(edad = +5);", "answer": "5", "hint": "Assignment returns the assigned value; unary + coerces to number.", "explain": "+5 is just 5. edad becomes 5 and the expression evaluates to 5."}
{"id": "OP2-4", "type": "short", "tier": 2, "lang": "en", "category": "Operators & Expressions", "subcat": "unary-minus-assignment", "setup": "var nombre="Jab";\nlet edad=18;\nconst OJOS=2;", "question": "What does the alert show?", "code": "alert(edad = -18);", "answer": "-18", "hint": "Unary - negates the numeric value.", "explain": "edad becomes -18; the assignment expression yields -18."}
{"id": "OP2-5", "type": "short", "tier": 2, "lang": "en", "category": "Operators & Expressions", "subcat": "strict-equality", "setup": "var nombre="Jab";\nlet edad=18;\nconst OJOS=2;", "question": "What does the alert show?", "code": "alert(edad === "18");", "answer": "false", "hint": "=== compares without type coercion.", "explain": "Number 18 is not strictly equal to string \"18\" → false."}
{"id": "OP2-6", "type": "short", "tier": 2, "lang": "en", "category": "Operators & Expressions", "subcat": "unary-plus-coercion", "setup": "const OJOS=2;", "question": "What does the alert show?", "code": "alert( +"18" + OJOS );", "answer": "20", "hint": "Unary + turns a numeric string into a number.", "explain": "+\"18\" → 18 (number). 18 + 2 = 20."}
{"id": "OP2-7", "type": "short", "tier": 2, "lang": "en", "category": "Operators & Expressions", "subcat": "string-concat", "setup": "const OJOS=2;", "question": "What does the alert show?", "code": "alert( "18" + OJOS );", "answer": "182", "hint": "Binary + concatenates if one side is a string.", "explain": "String + number → string concatenation: \"18\" + 2 → \"182\"."}
{"id": "OP2-8", "type": "short", "tier": 2, "lang": "en", "category": "Operators & Expressions", "subcat": "compound-assignment", "setup": "let edad=18;\nconst OJOS=2;", "question": "What does the alert show?", "code": "alert( (edad += 2) * OJOS );", "answer": "40", "hint": "x += y updates x and yields the new value.", "explain": "edad becomes 20; 20 * 2 = 40."}
{"id": "OP2-9", "type": "short", "tier": 2, "lang": "en", "category": "Operators & Expressions", "subcat": "mixed-increments", "setup": "let edad=18;\nconst OJOS=2;", "question": "What does the alert show?", "code": "alert( ++edad + edad++ + OJOS );", "answer": "40", "hint": "Prefix changes first; postfix uses old value, then updates.", "explain": "++edad → 19 (edad=19). edad++ yields 19 then makes edad=20. Sum: 19 + 19 + 2 = 40."}
{"id": "OP2-10", "type": "short", "tier": 2, "lang": "en", "category": "Operators & Expressions", "subcat": "precedence", "setup": "let edad=18;\nconst OJOS=2;", "question": "What does the alert show?", "code": "alert( edad + OJOS * 3 );", "answer": "24", "hint": "Multiplication has higher precedence than addition.", "explain": "Compute 2 * 3 = 6 first, then 18 + 6 = 24."}