{"id": "OP6-1", "type": "short", "tier": 2, "lang": "es", "category": "Operadores", "subcat": "bitwise", "setup": "let a=5; let b=3;", "question": "¿Qué muestra el alert?", "code": "alert(a & b);", "answer": "1", "hint": "`5`=101, `3`=011 (AND bit a bit).", "explain": "101 & 011 = 001 → 1."}
{"id": "OP6-2", "type": "short", "tier": 2, "lang": "es", "category": "Operadores", "subcat": "bitwise", "setup": "let a=5; let b=3;", "question": "¿Qué muestra el alert?", "code": "alert(a | b);", "answer": "7", "hint": "OR bit a bit.", "explain": "101 | 011 = 111 → 7."}
{"id": "OP6-3", "type": "short", "tier": 2, "lang": "es", "category": "Operadores", "subcat": "typeof/NaN", "setup": "let v = NaN;", "question": "¿Qué muestra el alert?", "code": "alert(typeof v);", "answer": "number", "hint": "`NaN` es de tipo numérico.", "explain": "`typeof NaN` devuelve `'number'`."}
{"id": "OP6-4", "type": "short", "tier": 2, "lang": "es", "category": "Operadores", "subcat": "ternario", "setup": "let edad=20;", "question": "¿Qué muestra el alert?", "code": "alert(edad>=18 ? 'ok' : 'no');", "answer": "ok", "hint": "Condición verdadera → rama izquierda.", "explain": "20≥18 → `'ok'`."}
