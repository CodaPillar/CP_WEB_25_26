{"id": "AR3-1", "type": "short", "tier": 2, "lang": "en", "category": "Operators", "subcat": "special-cases", "question": "What does console.log print?", "code": "console.log(1 / 0);", "answer": "Infinity", "hint": "Division by zero yields `Infinity` in JS.", "explain": "JavaScript doesn’t throw here; it produces `Infinity`."}
{"id": "AR3-2", "type": "short", "tier": 2, "lang": "en", "category": "Operators", "subcat": "special-cases", "question": "What does console.log print?", "code": "console.log(-1 / 0);", "answer": "-Infinity", "hint": "Sign is preserved.", "explain": "Negative divided by zero is `-Infinity`."}
{"id": "AR3-3", "type": "short", "tier": 2, "lang": "en", "category": "Operators", "subcat": "special-cases", "question": "What does console.log print?", "code": "console.log(0 / 0);", "answer": "NaN", "hint": "Indeterminate form → `NaN`.", "explain": "`0/0` is not a number."}
{"id": "AR3-4", "type": "short", "tier": 2, "lang": "en", "category": "Operators", "subcat": "special-cases", "question": "What does console.log print?", "code": "console.log(+\"foo\");", "answer": "NaN", "hint": "Unary plus tries numeric conversion.", "explain": "A non‑numeric string becomes `NaN`."}
{"id": "AR3-5", "type": "short", "tier": 2, "lang": "en", "category": "Operators", "subcat": "exponent/precedence", "question": "What does console.log print?", "code": "console.log(-(2 ** 3));", "answer": "-8", "hint": "Exponentiation binds tighter than unary minus.", "explain": "`2 ** 3` is 8; unary minus → `-8`."}
{"id": "AR3-6", "type": "short", "tier": 2, "lang": "en", "category": "Operators", "subcat": "remainder", "question": "What does console.log print?", "code": "console.log(-7 % 4);", "answer": "-3", "hint": "Remainder keeps the sign of the dividend in JS.", "explain": "In JS, `-7 % 4` is `-3`."}
{"id": "AR3-7", "type": "short", "tier": 2, "lang": "en", "category": "Operators", "subcat": "floating", "question": "What does console.log print?", "code": "console.log(0.1 + 0.2);", "answer": "0.30000000000000004", "hint": "Binary floating‑point has rounding error.", "explain": "0.1 and 0.2 are not exactly representable; the sum is `0.30000000000000004`."}
{"id": "AR3-8", "type": "short", "tier": 2, "lang": "en", "category": "Operators", "subcat": "exponent/edge", "question": "What does console.log print?", "code": "console.log(0 ** 0);", "answer": "1", "hint": "In JS, `0 ** 0` is defined as 1.", "explain": "The exponentiation operator defines this edge case as `1`."}
