{"id": "pla3_s_q01", "tier": 1, "category": "Funciones", "subcat": "Parámetros", "question": "¿Qué son los parámetros de una función?", "options": {"A": "Datos que se indican entre paréntesis al declararla", "B": "Variables locales dentro del cuerpo", "C": "Propiedades del objeto window", "D": "Comentarios arriba de la función"}, "answer": "A", "hint": "Se declaran entre paréntesis al definir la función."}
{"id": "pla3_s_q02", "tier": 1, "category": "Eventos", "subcat": "Teclado", "question": "¿Qué evento detecta la pulsación de una tecla?", "options": {"A": "keydown", "B": "onkey", "C": "keycode", "D": "onkeycode"}, "answer": "A", "hint": "El tipo de evento es sin 'on'."}
{"id": "pla3_s_q03", "tier": 1, "category": "DOM", "subcat": "Inputs", "question": "¿Qué instrucción devuelve el texto actual de un <input>?", "options": {"A": "innerHTML", "B": "value()", "C": "value", "D": "input"}, "answer": "C", "hint": "Es una propiedad, no un método."}
{"id": "pla3_s_q04", "tier": 1, "category": "Tipos", "subcat": "Conversión", "question": "¿Para convertir a numérico el valor de un <input> podemos usar…?", "options": {"A": "Integer", "B": "Number", "C": "toFixed", "D": "toInteger"}, "answer": "B", "hint": "Number('3.5') → 3.5."}
{"id": "pla3_s_q05", "tier": 1, "category": "DOM", "subcat": "Focus", "question": "¿Para enfocar un <input> usamos…?", "options": {"A": "innerHTML", "B": "value", "C": "focus", "D": "focus()"}, "answer": "D", "hint": "Es un método."}
{"id": "pla3_s_q06", "tier": 1, "category": "Eventos", "subcat": "Handlers", "question": "Los eventos apuntan…", "options": {"A": "…siempre a otros eventos", "B": "…siempre a funciones", "C": "…a etiquetas HTML", "D": "…a hojas de estilo"}, "answer": "B", "hint": "Un manejador es una función."}
{"id": "pla3_s_q07", "tier": 1, "category": "Eventos", "subcat": "Objeto evento", "question": "¿Qué cabecera de función es correcta para leer el objeto evento?", "options": {"A": "function teclado(){", "B": "function teclado(a,b){", "C": "function teclado(evento){", "D": "function teclado{"}, "answer": "C", "hint": "Recibe el parámetro e/evento."}
{"id": "pla3_s_q08", "tier": 1, "category": "Eventos", "subcat": "Teclado", "question": "¿Qué propiedad da la tecla pulsada de forma semántica?", "options": {"A": "event.key", "B": "event.keyCode", "C": "event.which", "D": "event.button"}, "answer": "A", "hint": "key devuelve 'Enter', 'a', etc."}
{"id": "pla3_s_q09", "tier": 1, "category": "Números", "subcat": "Formato", "question": "¿Para fijar el número de decimales usamos…?", "options": {"A": "Number", "B": "toFixed", "C": "Integer", "D": "numeric"}, "answer": "B", "hint": "toFixed(n) devuelve una cadena."}
{"id": "pla3_s_q10", "tier": 1, "category": "Eventos", "subcat": "Asignación", "question": "¿Cuál es la sintaxis correcta para añadir un manejador?", "options": {"A": "input.addEventListener('keydown', teclado)", "B": "input.addEventListener = ('keydown', teclado)", "C": "input.onkeydown('teclado')", "D": "addEventListener(input, 'keydown', teclado)"}, "answer": "A", "hint": "addEventListener(tipo, función)."}
{"id": "pla3_s_q11", "tier": 1, "category": "DOM", "subcat": "querySelector", "question": "¿Qué devuelve document.querySelector('#id') si no existe?", "options": {"A": "Lanza error", "B": "null", "C": "undefined", "D": "Un objeto vacío"}, "answer": "B", "hint": "Valida antes de usar."}
{"id": "pla3_s_q12", "tier": 1, "category": "DOM", "subcat": "Inputs", "question": "¿Cuál es la utilidad de valueAsNumber?", "options": {"A": "Obtener un número o NaN desde <input type='number'>", "B": "Devolver siempre una cadena", "C": "Forzar enteros", "D": "Formatear con decimales"}, "answer": "A", "hint": "Evita parseo manual; puede ser NaN."}
