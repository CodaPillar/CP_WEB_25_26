{"id":"EVT-40","type":"tri","tier":1,"lang":"en","category":"Selectors & Events","subcat":"getElementById","question":"Select the element with id 'btnCalc'. Which line is correct?","code":"","options":["const btn = document.getElementById('btnCalc');","const btn = document.getElementById('#btnCalc');","const btn = document.querySelector('btnCalc');"],"answer":"const btn = document.getElementById('btnCalc');","hint":"getElementById uses the raw id (no #).","explain":"`getElementById('id')` expects just the id text, not a CSS selector."}
{"id":"EVT-41","type":"tri","tier":1,"lang":"en","category":"Selectors & Events","subcat":"querySelector-id","question":"Using querySelector, pick the line that selects id='btnCalc'.","code":"","options":["const btn = document.querySelector('#btnCalc');","const btn = document.querySelector('btnCalc');","const btn = document.querySelector('.btnCalc');"],"answer":"const btn = document.querySelector('#btnCalc');","hint":"Use CSS syntax: # for id, . for class.","explain":"`querySelector('#btnCalc')` returns the element with that id."}
{"id":"EVT-42","type":"tri","tier":1,"lang":"en","category":"Selectors & Events","subcat":"querySelectorAll-class","question":"Select all elements with class 'calcBtn'.","code":"","options":["const btns = document.querySelectorAll('.calcBtn');","const btns = document.querySelectorAll('#calcBtn');","const btns = document.getElementsByClassName('#calcBtn');"],"answer":"const btns = document.querySelectorAll('.calcBtn');","hint":"Class selectors start with a dot.","explain":"`querySelectorAll('.calcBtn')` returns a NodeList of all matches."}
{"id":"EVT-43","type":"tri","tier":1,"lang":"en","category":"Selectors & Events","subcat":"bind-click","question":"Attach a click to call doConversion (don’t call it now). Which is correct?","code":"const btn = document.getElementById('btnCalc');","options":["btn.addEventListener('click', doConversion);","btn.addEventListener('click', doConversion());","btn.addEventListener(click, 'doConversion');"],"answer":"btn.addEventListener('click', doConversion);","hint":"Event type is a quoted string; pass a function reference.","explain":"No parentheses when registering the handler."}
{"id":"EVT-44","type":"tri","tier":1,"lang":"en","category":"Selectors & Events","subcat":"call-vs-ref","question":"Which binding does NOT execute immediately?","code":"","options":["btn.addEventListener('click', run);","btn.addEventListener('click', run());","btn.onclick = run();"],"answer":"btn.addEventListener('click', run);","hint":"Passing a reference defers execution until the event fires.","explain":"`run` is a reference; `run()` calls now."}
{"id":"EVT-45","type":"tri","tier":2,"lang":"en","category":"Selectors & Events","subcat":"args-wrapper","question":"You must pass 42 to run(x) when clicked. Pick the correct binding.","code":"const btn = document.querySelector('#btnCalc'); function run(x){ /*...*/ }","options":["btn.addEventListener('click', () => run(42));","btn.addEventListener('click', run(42));","btn.addEventListener('click', 'run(42)');"],"answer":"btn.addEventListener('click', () => run(42));","hint":"Wrap the call in an arrow to defer it.","explain":"`() => run(42)` creates a function to call later with an argument."}
{"id":"EVT-46","type":"tri","tier":2,"lang":"en","category":"Selectors & Events","subcat":"once-option","question":"Bind a click listener that runs only once.","code":"const btn = document.getElementById('btnCalc');","options":["btn.addEventListener('click', doConversion, { once: true });","btn.addEventListener('click', doConversion, { passive: true });","btn.addEventListener('click', doConversion, true);"],"answer":"btn.addEventListener('click', doConversion, { once: true });","hint":"There’s a built-in one-time flag.","explain":"`once:true` auto-removes the listener after the first call."}
{"id":"EVT-47","type":"tri","tier":2,"lang":"en","category":"Selectors & Events","subcat":"passive-scroll","question":"Best binding for scroll performance when you won’t call preventDefault.","code":"","options":["window.addEventListener('scroll', onScroll, { passive: true });","window.addEventListener('scroll', onScroll);","document.addEventListener('scroll', onScroll, true);"],"answer":"window.addEventListener('scroll', onScroll, { passive: true });","hint":"Hint that you won’t cancel the event.","explain":"`passive:true` lets the browser scroll smoothly without waiting."}
{"id":"EVT-48","type":"tri","tier":1,"lang":"en","category":"Selectors & Events","subcat":"remove-listener","question":"Remove a keydown listener previously added with the same function.","code":"function onKey(e){} document.addEventListener('keydown', onKey);","options":["document.removeEventListener('keydown', onKey);","document.removeEventListener('keydown', (e)=>onKey(e));","document.removeEventListener('keyup', onKey);"],"answer":"document.removeEventListener('keydown', onKey);","hint":"Same type + same reference.","explain":"Removal requires the exact same function reference and options."}
{"id":"EVT-49","type":"tri","tier":2,"lang":"en","category":"Selectors & Events","subcat":"delegation","question":"Choose the safest delegated click body for items under #list.","code":"const list = document.getElementById('list'); list.addEventListener('click',(e)=>{ /* body */ });","options":["const it = e.target.closest('.item'); if (it && list.contains(it)) selectItem(it);","selectItem(e.target);","const it = e.currentTarget; selectItem(it);"],"answer":"const it = e.target.closest('.item'); if (it && list.contains(it)) selectItem(it);","hint":"Climb from the target and guard containment.","explain":"`closest('.item')` finds the intended li even if an inner child was clicked; `contains` ensures it belongs to this list."}
