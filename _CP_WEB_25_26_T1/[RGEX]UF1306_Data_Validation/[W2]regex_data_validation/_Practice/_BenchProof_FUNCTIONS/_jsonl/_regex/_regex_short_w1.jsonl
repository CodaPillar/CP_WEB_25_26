{"id":"REG-SHORT-02","type":"short","tier":1,"lang":"en","category":"Regex • Test","subcat":"digits","question":"What does the console print?","code":"console.log(/^\\d{3}$/.test(\"12a\"));","answer":"false","hint":"Letters do not match \\d.","explain":"12a does not match because 'a' is not a digit."}
{"id":"REG-SHORT-03","type":"short","tier":1,"lang":"en","category":"Regex • Sets","subcat":"vowels","question":"What does it log?","code":"console.log(/^[aeiou]$/.test(\"x\"));","answer":"false","hint":"x is not a vowel.","explain":"The set [aeiou] excludes 'x'."}
{"id":"REG-SHORT-04","type":"short","tier":1,"lang":"en","category":"Regex • Sets","subcat":"negset","question":"What happens here?","code":"console.log(/^[^aeiou]$/.test(\"b\"));","answer":"true","hint":"b is a consonant.","explain":"Negated vowel set accepts consonants."}
