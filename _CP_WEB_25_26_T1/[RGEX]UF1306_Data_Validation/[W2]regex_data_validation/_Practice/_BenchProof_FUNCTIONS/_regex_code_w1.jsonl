{"id":"REG-CODE-01","type":"code","tier":1,"lang":"en","category":"Regex • Code","subcat":"digits","prompt":"Write a regex that matches exactly 3 digits.","scaffold":"/^\\d{3}$/","validator":{"mode":"regex","tests":["/^\\d{3}$/.test('123')","!/^\\d{3}$/.test('12a')","!/^\\d{3}$/.test('12')"]},"hint":"Use ^, $, and {3}.","explain":"^ and $ enforce full-string match; {3} repeats a digit three times."}
{"id":"REG-CODE-02","type":"code","tier":1,"lang":"en","category":"Regex • Code","subcat":"letters","prompt":"Write a regex that matches one or more letters only (A–Z, a–z).","scaffold":"/^[A-Za-z]+$/","validator":{"mode":"regex","tests":["/^[A-Za-z]+$/.test('Ana')","!/^[A-Za-z]+$/.test('A1')"]},"hint":"Use ranges and +.","explain":"+ repeats the allowed class one or more times."}
{"id":"REG-CODE-03","type":"code","tier":1,"lang":"en","category":"Regex • Code","subcat":"vowel","prompt":"Write a regex that matches a single lowercase vowel.","scaffold":"/^[aeiou]$/","validator":{"mode":"regex","tests":["/^[aeiou]$/.test('a')","!/^[aeiou]$/.test('A')"]},"hint":"Use a character set with anchors.","explain":"[aeiou] matches any single lowercase vowel."}
{"id":"REG-CODE-04","type":"code","tier":1,"lang":"en","category":"Regex • Code","subcat":"postal","prompt":"Write a regex that matches a 5-digit postal code.","scaffold":"/^\\d{5}$/","validator":{"mode":"regex","tests":["/^\\d{5}$/.test('08912')","!/^\\d{5}$/.test('0891A')"]},"hint":"Quantifier {5}.","explain":"Only digits, exactly 5."}
{"id":"REG-CODE-05","type":"code","tier":1,"lang":"en","category":"Regex • Code","subcat":"or","prompt":"Write a regex that matches exactly 'cat' or 'dog'.","scaffold":"/^(cat|dog)$/","validator":{"mode":"regex","tests":["/^(cat|dog)$/.test('cat')","!/^(cat|dog)$/.test('hotdog')"]},"hint":"Group with |.","explain":"Use a group and anchors to restrict full string."}
