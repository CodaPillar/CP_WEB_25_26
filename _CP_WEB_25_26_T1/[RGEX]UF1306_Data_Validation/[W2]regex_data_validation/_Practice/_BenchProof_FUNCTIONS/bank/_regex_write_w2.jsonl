{"id":"REG-WRITE-01","type":"code","tier":1,"lang":"en","category":"Regex • Write","subcat":"phone","prompt":"Write a regex for a phone number of 6–8 digits (no spaces).","scaffold":"^\\d{6,8}$","validator":{"mode":"regex","tests":["/^\\d{6,8}$/.test('123456')","/^\\d{6,8}$/.test('12345678')","!/^\\d{6,8}$/.test('123')","!/^\\d{6,8}$/.test('12-3456')"]},"hint":"Digits only, between 6 and 8.","explain":"The pattern uses \\d for digits, {6,8} for range, and anchors to restrict the whole string."}

{"id":"REG-WRITE-02","type":"code","tier":1,"lang":"en","category":"Regex • Write","subcat":"country-phone","prompt":"Write a regex starting with literal +, followed by 1–3 digits (country code), then 9 digits (phone).","scaffold":"^\\+\\d{1,3}\\d{9}$","validator":{"mode":"regex","tests":["/^\\+\\d{1,3}\\d{9}$/.test('+34123456789')","/^\\+\\d{1,3}\\d{9}$/.test('+112345678901')","!/^\\+\\d{1,3}\\d{9}$/.test('34123456789')","!/^\\+\\d{1,3}\\d{9}$/.test('+34 123456789')"]},"hint":"Escape +, then 1–3 digits, then 9 digits.","explain":"^\\+ anchors the literal plus, then the digit counts enforce country code + number."}

{"id":"REG-WRITE-03","type":"code","tier":1,"lang":"en","category":"Regex • Write","subcat":"html-open","prompt":"Write a regex for an HTML opening tag like <div> (letter first, then letters or digits).","scaffold":"^<[A-Za-z][A-Za-z0-9]*>$","validator":{"mode":"regex","tests":["/^<[A-Za-z][A-Za-z0-9]*>$/.test('<div>')","/^<[A-Za-z][A-Za-z0-9]*>$/.test('<h1>')","!/^<[A-Za-z][A-Za-z0-9]*>$/.test('<1tag>')","!/^<[A-Za-z][A-Za-z0-9]*>$/.test('<>')"]},"hint":"Must not start with a digit.","explain":"First character is a letter; the rest may include digits."}

{"id":"REG-WRITE-04","type":"code","tier":1,"lang":"en","category":"Regex • Write","subcat":"html-close","prompt":"Write a regex for an HTML closing tag like </div>.","scaffold":"^</[A-Za-z][A-Za-z0-9]*>$","validator":{"mode":"regex","tests":["/^</[A-Za-z][A-Za-z0-9]*>$/.test('</div>')","/^</[A-Za-z][A-Za-z0-9]*>$/.test('</h2>')","!/^</[A-Za-z][A-Za-z0-9]*>$/.test('<div>')","!/^</[A-Za-z][A-Za-z0-9]*>$/.test('</123>')"]},"hint":"Just add </ before the opening-tag pattern.","explain":"Same rules as opening tags but with the forward slash."}

{"id":"REG-WRITE-05","type":"code","tier":2,"lang":"en","category":"Regex • Write","subcat":"date-basic","prompt":"Date dd/mm/yyyy or dd-mm-yyyy (allowing 00 as day).","scaffold":"^([0-2][0-9]|3[0-1])(\\/|-)(0[1-9]|1[0-2])\\2\\d{4}$","validator":{"mode":"regex","tests":["/^([0-2][0-9]|3[0-1])(\\/|-)(0[1-9]|1[0-2])\\2\\d{4}$/.test('00/12/2023')","/^([0-2][0-9]|3[0-1])(\\/|-)(0[1-9]|1[0-2])\\2\\d{4}$/.test('15-03-2020')","!/^([0-2][0-9]|3[0-1])(\\/|-)(0[1-9]|1[0-2])\\2\\d{4}$/.test('12/13/2023')"]},"hint":"This version allows 00 intentionally.","explain":"[0-2][0-9] allows 00–29; 3[0-1] covers 30–31; \\2 repeats separator."}

{"id":"REG-WRITE-06","type":"code","tier":2,"lang":"en","category":"Regex • Write","subcat":"date-strict","prompt":"Date dd/mm/yyyy or dd-mm-yyyy (disallow 00).","scaffold":"^(0[1-9]|[12][0-9]|3[01])(\\/|-)(0[1-9]|1[0-2])\\2\\d{4}$","validator":{"mode":"regex","tests":["/^(0[1-9]|[12][0-9]|3[01])(\\/|-)(0[1-9]|1[0-2])\\2\\d{4}$/.test('01/12/2023')","/^(0[1-9]|[12][0-9]|3[01])(\\/|-)(0[1-9]|1[0-2])\\2\\d{4}$/.test('31-01-1999')","!/^(0[1-9]|[12][0-9]|3[01])(\\/|-)(0[1-9]|1[0-2])\\2\\d{4}$/.test('00/12/2023')"]},"hint":"Replace 0[0-9] with 0[1-9].","explain":"The first block forbids 00 by requiring 01–09 instead."}

{"id":"REG-WRITE-07","type":"code","tier":2,"lang":"en","category":"Regex • Write","subcat":"email","prompt":"Write a regex for an email allowing dots and hyphens in both username and domain.","scaffold":"^[\\w.-]+@[\\w.-]+\\.[A-Za-z]{2,}$","validator":{"mode":"regex","tests":["/^[\\w.-]+@[\\w.-]+\\.[A-Za-z]{2,}$/.test('mar.sky@weather-map.net')","/^[\\w.-]+@[\\w.-]+\\.[A-Za-z]{2,}$/.test('user@mail.com')","!/^[\\w.-]+@[\\w.-]+\\.[A-Za-z]{2,}$/.test('user@mail')"]},"hint":"Use [\\w.-]+ for both sides.","explain":"This allows dots, hyphens and word characters before and after @."}

{"id":"REG-WRITE-08","type":"code","tier":2,"lang":"en","category":"Regex • Write","subcat":"url","prompt":"Write a regex for http/https/ftp URLs with domain blocks and optional path.","scaffold":"^(https?|ftp):\\/\\/[\\w.-]+(?:\\.[\\w.-]+)+(?:\\/\\S*)?$","validator":{"mode":"regex","tests":["/^(https?|ftp):\\/\\/[\\w.-]+(?:\\.[\\w.-]+)+(?:\\/\\S*)?$/.test('https://mail.server.com')","/^(https?|ftp):\\/\\/[\\w.-]+(?:\\.[\\w.-]+)+(?:\\/\\S*)?$/.test('ftp://sub.domain.net/path')","!/^(https?|ftp):\\/\\/[\\w.-]+(?:\\.[\\w.-]+)+(?:\\/\\S*)?$/.test('http://domain')"]},"hint":"After the first domain block, repeat .something at least once.","explain":"The non-capturing group ensures multiple domain segments like sub.domain.com."}

{"id":"REG-WRITE-09","type":"code","tier":2,"lang":"en","category":"Regex • Write","subcat":"rgb","prompt":"Write a regex for RGB format: RGB(255,255,255).","scaffold":"^RGB\\((\\d{1,3}),(\\d{1,3}),(\\d{1,3})\\)$","validator":{"mode":"regex","tests":["/^RGB\\((\\d{1,3}),(\\d{1,3}),(\\d{1,3})\\)$/.test('RGB(12,34,255)')","!/^(RGB\\((\\d{1,3}),(\\d{1,3}),(\\d{1,3})\\)$/.test('RGB(12,34,)')"]},"hint":"Literal RGB( ... ), commas, and numbers.","explain":"Each color channel is 1–3 digits."}

{"id":"REG-WRITE-10","type":"code","tier":3,"lang":"en","category":"Regex • Write","subcat":"iban-basic","prompt":"IBAN without spaces: ES + 22 digits.","scaffold":"^ES\\d{22}$","validator":{"mode":"regex","tests":["/^ES\\d{22}$/.test('ES1234567890123456789012')","!/^ES\\d{22}$/.test('ES123')"]},"hint":"ES then exactly 22 digits.","explain":"The IBAN structure forbids extra characters."}

{"id":"REG-WRITE-11","type":"code","tier":3,"lang":"en","category":"Regex • Write","subcat":"iban-spaced","prompt":"IBAN spaced form: ES + 2 digits + 5 groups of (space + 4 digits).","scaffold":"^ES\\d{2}(?:\\s\\d{4}){5}$","validator":{"mode":"regex","tests":["/^ES\\d{2}(?:\\s\\d{4}){5}$/.test('ES12 1234 5678 9012 3456 7890')","!/^ES\\d{2}(?:\\s\\d{4}){5}$/.test('ES12 1234 5678 9012 3456')"]},"hint":"Repeat the block five times.","explain":"(?:\\s\\d{4}) groups the block; {5} repeats it."}

{"id":"REG-WRITE-12","type":"code","tier":3,"lang":"en","category":"Regex • Write","subcat":"password","prompt":"Password: ≥8 characters, ≥1 uppercase, ≥1 lowercase.","scaffold":"^(?=.*[a-z])(?=.*[A-Z]).{8,}$","validator":{"mode":"regex","tests":["/^(?=.*[a-z])(?=.*[A-Z]).{8,}$/.test('Password1')","!/^(?=.*[a-z])(?=.*[A-Z]).{8,}$/.test('password')","!/^(?=.*[a-z])(?=.*[A-Z]).{8,}$/.test('PASSWORD')"]},"hint":"Use lookaheads to check conditions.","explain":"Lookaheads ensure the presence of uppercase and lowercase; final block enforces length."}
